# ── Base de données PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=defisante
POSTGRES_USER=defisante_user
POSTGRES_PASSWORD=defisante_pass

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=changez_moi_en_production
JWT_SECRET_KEY=jwt_secret_changez_moi

# ── pgAdmin (interface web PostgreSQL, accessible sur http://localhost:5050) 
PGADMIN_EMAIL=admin@defisante.local
PGADMIN_PASSWORD=admin
